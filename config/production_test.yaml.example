# Production Test Configuration
# Copy this to production_test.yaml and fill in your details

channel:
  # Your YouTube channel name
  name: "My YouTube Channel"

  # Unique identifier for SEO Manager
  site_id: "my_channel_youtube"

# Map your YouTube video IDs to content IDs
# Find video IDs from YouTube Studio or video URLs
# Example: https://youtube.com/watch?v=dQw4w9WgXcQ → ID is "dQw4w9WgXcQ"
video_mapping:
  # Format: "youtube_video_id": "content_id"

  # Add at least 5-10 videos for good pattern analysis
  # More videos = better optimization

  # Example:
  # "dQw4w9WgXcQ": "video_001"
  # "9bZkp7q19f0": "video_002"
  # "jNQXAC9IVRw": "video_003"

  # YOUR VIDEOS HERE:
  "REPLACE_WITH_VIDEO_ID_1": "video_001"
  "REPLACE_WITH_VIDEO_ID_2": "video_002"
  "REPLACE_WITH_VIDEO_ID_3": "video_003"
  "REPLACE_WITH_VIDEO_ID_4": "video_004"
  "REPLACE_WITH_VIDEO_ID_5": "video_005"

# New video you want to optimize
new_video:
  # The topic/working title for your next video
  topic: "My New Video Topic"

  # Brief description (optional, helps with optimization)
  description: "This video is about..."

  # Any tags you definitely want to include
  existing_tags:
    - "must-have-tag-1"
    - "must-have-tag-2"
    - "must-have-tag-3"

  # Optional: Episode information (if applicable)
  episode_number: null  # Set to number if episodic content
  show_name: null       # Set to show name if applicable
